# Set a canonical URL only after a real domain is connected
NEXT_PUBLIC_SITE_URL=
# Required to query official US company records; use company name and a real contact address.
# Example format: CREQOR research research-contact@yourdomain.example
SEC_USER_AGENT=
# Analyst access key for entity research and the /analyst desk; never embed in the frontend.
# All model calls run on the private DGX engine (DGX_ENGINE_HTTPS_URL / DGX_ENGINE_TOKEN below);
# the website never talks to an inference endpoint directly.
CREQOR_ANALYST_ACCESS_TOKEN=

# Optional persistent public LEI catalogue; production remains live-search-only without this.
# Provision a dedicated Postgres 15+ database and apply db/migrations/001_lei_catalogue.sql
# with restricted access BEFORE enabling. Require TLS on remote databases.
DATABASE_URL=
# CRON_SECRET is used by the existing hourly smoke check and catalogue ingestion.
# Set in Vercel as an encrypted/sensitive environment variable, never in source.
CRON_SECRET=

# DGX private intelligence engine (separate from the existing local vLLM adapter).
# Only provide an HTTPS gateway origin protected by an identity/service-token policy.
DGX_ENGINE_HTTPS_URL=
DGX_ENGINE_TOKEN=
# Pair is optional; both required for a Cloudflare Access service-token policy.
DGX_ACCESS_CLIENT_ID=
DGX_ACCESS_CLIENT_SECRET=
# Host-only settings, from infrastructure/dgx/.env.dgx.example:
# DGX_ENGINE_BIND_HOST=127.0.0.1
# DGX_ENGINE_PORT=8188
# DGX_AI_ENABLED=false
# DGX_VLLM_ENDPOINT=http://127.0.0.1:8001/v1/chat/completions
