[Unit]
Description=CREQOR DGX backup job
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/creqor-platform/app
ExecStart=%h/creqor-platform/app/scripts/dgx-jobs.sh backup
# Warnings (exit 3) are recorded in cq_job_runs but are not unit failures.
SuccessExitStatus=3
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
