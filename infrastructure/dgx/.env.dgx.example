# Copy to repository root as .env.dgx; NEVER commit .env.dgx.
# Put Postgres on an encrypted, backed-up SSD/NVMe volume with sufficient free space.
CREQOR_DATA_DIR=/srv/creqor
# Use a long, URI-safe random password (for example 32+ hex bytes).
CREQOR_DB_PASSWORD=
# Independent long random service-to-service key; never expose to a browser.
DGX_ENGINE_TOKEN=
# Exact model ID served by the existing local vLLM server, if AI analysis is enabled.
DGX_MODEL=
# SEC requires a genuine organization + monitored contact email before collection.
SEC_USER_AGENT=
# Empty disables AI narrative; deterministic summaries and storage still work.
DGX_AI_ENABLED=false
