# Copy to repository root as .env.dgx (chmod 600); NEVER commit .env.dgx.
# Generate every secret with: openssl rand -hex 32
# Durable storage for Postgres data and import scratch space (needs ~60 GB for the
# full GLEIF index, observations and indexes; more for SEC facts).
CREQOR_DATA_DIR=/srv/creqor
# Database owner (migrations, backups only). URL-safe hex.
CREQOR_DB_PASSWORD=
# Least-privilege runtime roles enabled by scripts/dgx-db-bootstrap.sh.
CREQOR_APP_DB_PASSWORD=
CREQOR_INGEST_DB_PASSWORD=
# Independent service-to-service bearer token (>= 32 chars); also set in Vercel.
DGX_ENGINE_TOKEN=
# Loopback port for the engine (8188 is commonly taken on shared DGX hosts).
DGX_ENGINE_PORT=8196
# Existing local vLLM OpenAI-compatible endpoint (loopback only) and exact served model id.
DGX_VLLM_ENDPOINT=http://127.0.0.1:8002/v1/chat/completions
DGX_MODEL=
# false disables AI narrative; deterministic sourced analysis still works.
DGX_AI_ENABLED=false
# Max concurrent model calls from CREQOR (protects shared GPU capacity).
DGX_AI_MAX_CONCURRENCY=2
# SEC requires a genuine organisation + monitored contact email before collection.
# Leave empty to keep SEC ingestion disabled.
SEC_USER_AGENT=
# Image tag loaded on the host (scripts/dgx-relay.sh builds and ships it).
CREQOR_RELEASE=local
# age public recipient for encrypted backups (private key must live OFF the DGX).
DGX_BACKUP_RECIPIENT=
DGX_BACKUP_DIR=/srv/creqor/backups
DGX_BACKUP_KEEP=14
